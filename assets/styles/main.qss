/* ============================================================
   Gold & Silver Loan Management System — Main Stylesheet
   Light Theme (dark theme toggled via .dark class on QMainWindow)
   ============================================================ */

QMainWindow, QDialog, QWidget {
    background-color: #F8F9FA;
    color: #1A1A2E;
    font-family: "Segoe UI", "Inter", "Arial", sans-serif;
    font-size: 14px;
}

/* ---- Sidebar ---- */
#Sidebar {
    background-color: #1A1A2E;
    min-width: 220px;
    max-width: 220px;
    border-right: 1px solid #2D2D44;
}

#SidebarLogo {
    background-color: #1A1A2E;
    color: #FFD700;
    font-size: 16px;
    font-weight: 700;
    padding: 20px 16px 12px 16px;
    border-bottom: 1px solid #2D2D44;
}

#SidebarSubtitle {
    color: #C0C0C0;
    font-size: 10px;
    padding: 0 16px 16px 16px;
    background-color: #1A1A2E;
}

QPushButton#SidebarBtn {
    background-color: transparent;
    color: #C0C0C0;
    border: none;
    text-align: left;
    padding: 12px 20px;
    font-size: 13px;
    border-radius: 0;
}

QPushButton#SidebarBtn:hover {
    background-color: #2D2D44;
    color: #FFD700;
}

QPushButton#SidebarBtn[active="true"] {
    background-color: #FFD700;
    color: #1A1A2E;
    font-weight: 600;
    border-left: 4px solid #FFA500;
}

/* ---- Top Bar ---- */
#TopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 8px 20px;
    min-height: 52px;
}

#PageTitle {
    font-size: 18px;
    font-weight: 700;
    color: #1A1A2E;
}

#UserInfo {
    color: #555;
    font-size: 12px;
}

/* ---- Content Area ---- */
#ContentArea {
    background-color: #F8F9FA;
}

/* ---- Stat Cards ---- */
#StatCard {
    background-color: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 12px;
    padding: 16px;
}

#StatCard:hover {
    border: 1px solid #FFD700;
    box-shadow: 0 2px 8px rgba(255, 215, 0, 0.15);
}

#StatCardTitle {
    color: #777;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

#StatCardValue {
    color: #1A1A2E;
    font-size: 24px;
    font-weight: 700;
}

#StatCardChange {
    font-size: 11px;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #FFD700;
    color: #1A1A2E;
    border: none;
    padding: 8px 18px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 13px;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #FFC200;
}

QPushButton:pressed {
    background-color: #E6AC00;
}

QPushButton:disabled {
    background-color: #DDD;
    color: #999;
}

QPushButton#SecondaryBtn {
    background-color: #F0F0F0;
    color: #1A1A2E;
    border: 1px solid #CCC;
}

QPushButton#SecondaryBtn:hover {
    background-color: #E0E0E0;
}

QPushButton#DangerBtn {
    background-color: #DC3545;
    color: #FFFFFF;
}

QPushButton#DangerBtn:hover {
    background-color: #C82333;
}

QPushButton#SuccessBtn {
    background-color: #28A745;
    color: #FFFFFF;
}

QPushButton#SuccessBtn:hover {
    background-color: #218838;
}

/* ---- Inputs ---- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #D0D0D0;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #1A1A2E;
    min-height: 32px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QDateEdit:focus {
    border: 2px solid #FFD700;
    outline: none;
}

QLineEdit:disabled, QComboBox:disabled {
    background-color: #F5F5F5;
    color: #888;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CCC;
    selection-background-color: #FFD700;
    selection-color: #1A1A2E;
}

/* ---- Table ---- */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 8px;
    gridline-color: #F0F0F0;
    selection-background-color: #FFF5CC;
    selection-color: #1A1A2E;
    alternate-background-color: #FAFAFA;
    font-size: 13px;
}

QTableWidget::item, QTableView::item {
    padding: 8px 10px;
    border: none;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #FFF5CC;
    color: #1A1A2E;
}

QHeaderView::section {
    background-color: #F5F5F5;
    color: #333;
    font-weight: 600;
    font-size: 12px;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #FFD700;
    text-transform: uppercase;
}

/* ---- Labels ---- */
QLabel#SectionTitle {
    font-size: 16px;
    font-weight: 700;
    color: #1A1A2E;
}

QLabel#FieldLabel {
    font-size: 12px;
    color: #555;
    font-weight: 600;
}

QLabel#ErrorLabel {
    color: #DC3545;
    font-size: 12px;
}

QLabel#SuccessLabel {
    color: #28A745;
    font-size: 12px;
}

QLabel#InfoLabel {
    color: #0056B3;
    font-size: 12px;
}

/* ---- Cards ---- */
#Card {
    background-color: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 10px;
    padding: 20px;
}

#GoldCard {
    background-color: #FFF8E1;
    border: 1px solid #FFD700;
    border-radius: 10px;
    padding: 16px;
}

#SilverCard {
    background-color: #F0F0F0;
    border: 1px solid #C0C0C0;
    border-radius: 10px;
    padding: 16px;
}

/* ---- Status Badges ---- */
QLabel#BadgeActive      { color: #28A745; background: #D4EDDA; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: 700; }
QLabel#BadgeOverdue     { color: #DC3545; background: #F8D7DA; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: 700; }
QLabel#BadgePending     { color: #856404; background: #FFF3CD; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: 700; }
QLabel#BadgeClosed      { color: #495057; background: #E2E3E5; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: 700; }
QLabel#BadgeDraft       { color: #0056B3; background: #CCE5FF; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: 700; }

/* ---- Tabs ---- */
QTabWidget::pane {
    border: 1px solid #E8E8E8;
    border-radius: 8px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #F0F0F0;
    color: #555;
    padding: 8px 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #FFD700;
    color: #1A1A2E;
}

QTabBar::tab:hover {
    background-color: #FFE066;
}

/* ---- Scroll Bars ---- */
QScrollBar:vertical {
    width: 8px;
    background: #F0F0F0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #CCC;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #FFD700;
}

/* ---- Messages / Notifications ---- */
#NotificationCard {
    background-color: #FFFFFF;
    border-left: 4px solid #FFD700;
    border-radius: 4px;
    padding: 10px 14px;
    margin: 4px 0;
}

#NotificationCard[severity="error"] { border-left-color: #DC3545; }
#NotificationCard[severity="warning"] { border-left-color: #FFC107; }
#NotificationCard[severity="success"] { border-left-color: #28A745; }
#NotificationCard[severity="info"] { border-left-color: #17A2B8; }

/* ---- Login Window ---- */
#LoginPanel {
    background-color: #FFFFFF;
    border-radius: 16px;
    padding: 40px;
    min-width: 380px;
}

#LoginTitle {
    font-size: 22px;
    font-weight: 700;
    color: #1A1A2E;
}

#LoginSubtitle {
    font-size: 13px;
    color: #666;
}

/* ---- Splash Screen ---- */
#SplashScreen {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1A1A2E, stop:1 #2D2D44);
    border-radius: 16px;
}

#SplashTitle {
    color: #FFD700;
    font-size: 26px;
    font-weight: 800;
}

#SplashSubtitle {
    color: #C0C0C0;
    font-size: 13px;
}

#SplashProgress {
    background-color: #2D2D44;
    border-radius: 4px;
    height: 6px;
}

#SplashProgress::chunk {
    background-color: #FFD700;
    border-radius: 4px;
}

/* ---- Dialog ---- */
QDialog {
    background-color: #FFFFFF;
}

/* ---- Separator ---- */
QFrame[frameShape="4"] {
    color: #E8E8E8;
}

/* ---- GroupBox ---- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 8px;
    margin-top: 16px;
    font-weight: 600;
    color: #1A1A2E;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #1A1A2E;
    font-weight: 700;
    font-size: 13px;
}

/* ---- CheckBox / RadioButton ---- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #1A1A2E;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #CCC;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #FFD700;
    border-color: #FFD700;
}

/* ---- Tool Tip ---- */
QToolTip {
    background-color: #1A1A2E;
    color: #FFD700;
    border: none;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 4px;
}
